---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScheduleButton from "../components/ScheduleButton.astro";
import { business } from "../data/business";
import { areas } from "../data/areas";

const excludedZips = [
  "77013", "77016", "77026", "77033", "77048", "77051", "77060", "77072", "77093",
];

const allHoustonZips = [
  "77002", "77003", "77004", "77005", "77006", "77007", "77008", "77009", "77010",
  "77011", "77012", "77013", "77014", "77015", "77016", "77017", "77018", "77019",
  "77020", "77021", "77022", "77023", "77024", "77025", "77026", "77027", "77028",
  "77029", "77030", "77031", "77032", "77033", "77034", "77035", "77036", "77037",
  "77038", "77039", "77040", "77041", "77042", "77043", "77044", "77045", "77046",
  "77047", "77048", "77049", "77050", "77051", "77053", "77054", "77055", "77056",
  "77057", "77058", "77059", "77060", "77061", "77062", "77063", "77064", "77065",
  "77066", "77067", "77068", "77069", "77070", "77071", "77072", "77073", "77074",
  "77075", "77076", "77077", "77078", "77079", "77080", "77081", "77082", "77083",
  "77084", "77085", "77086", "77087", "77088", "77089", "77090", "77091", "77092",
  "77093", "77094", "77095", "77096", "77098", "77099",
];

const zips = allHoustonZips.filter((z) => !excludedZips.includes(z));

const surrounding = [
  { city: "Humble", zips: ["77338", "77346", "77396"] },
  { city: "Kingwood", zips: ["77339", "77345"] },
  { city: "Spring", zips: ["77373", "77379", "77386", "77388", "77389"] },
  { city: "The Woodlands", zips: ["77380", "77381", "77382", "77384", "77385"] },
  { city: "Cypress", zips: ["77429", "77433"] },
  { city: "Katy", zips: ["77449", "77450", "77493", "77494"] },
  { city: "Sugar Land", zips: ["77478", "77479", "77498"] },
  { city: "Pearland", zips: ["77581", "77584"] },
  { city: "Pasadena", zips: ["77502", "77503", "77504", "77505", "77506"] },
];
---
<BaseLayout
  title={`Áreas de Cobertura en Houston, TX | ${business.name}`}
  description={`${business.name} brinda servicios de plomería y reparaciones en casi todos los códigos postales de Houston y ciudades metropolitanas como Katy, Cypress, The Woodlands, Sugar Land y Pearland.`}
  path="/areas-we-serve"
>
  <!-- Banner -->
  <section class="bg-navy text-white border-b-4 border-brass">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <div class="flex items-center gap-2 font-display text-xs font-bold uppercase tracking-[0.2em] text-brass-light">
        <span class="h-2 w-2 rounded-full bg-brass"></span>
        Cobertura Total
      </div>
      <h1 class="hp-rise mt-3 font-display font-black text-4xl sm:text-5xl">
        Áreas y Vecindarios que Atendemos
      </h1>
      <p class="mt-4 max-w-2xl text-white/80 text-lg">
        Llegamos rápidamente a tu hogar o negocio en todo el Gran Houston y sus comunidades vecinas con técnicos listos las 24 horas.
      </p>
    </div>
  </section>

  <section class="px-6 py-16 max-w-5xl mx-auto">
    <div class="bg-white border border-navy/10 rounded-3xl p-8 sm:p-10 shadow-sm mb-12">
      <p class="text-navy/85 text-lg leading-relaxed mb-4">
        En <strong>{business.name}</strong> atendemos con orgullo todo <strong>{business.areaServed}</strong> y las ciudades circundantes, incluyendo Humble, Kingwood, Spring, Cypress, Katy, Sugar Land, Pearland y Pasadena. La comunidad nos prefiere porque conocemos a detalle el tipo de suelo, la presión de agua y los desafíos típicos de las tuberías en Texas.
      </p>
      <p class="text-navy/80 text-base leading-relaxed">
        Desde detección de fugas bajo losa y emergencias 24/7 hasta cambio de calentadores e inspección con cámara de video, contamos con licencia, seguro completo y equipamiento moderno para resolver cualquier problema a la primera.
      </p>
    </div>

    <!-- Neighborhood Landing Pages -->
    <h2 class="font-display font-black text-2xl sm:text-3xl text-navy mb-2">Comunidades Principales</h2>
    <p class="text-navy/70 mb-6">Haz clic en tu localidad para ver servicios y problemas comunes en tu zona:</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mb-16">
      {areas.map((a) => (
        <a href={`/areas/${a.slug}`} class="hp-lift group flex items-center justify-between gap-3 bg-white border border-navy/10 rounded-2xl px-5 py-4 shadow-sm hover:border-brass/40 hover:shadow-md transition-all">
          <span class="flex items-center gap-3">
            <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-navy text-brass-light">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <span class="font-display font-bold text-navy group-hover:text-water transition-colors text-base">Plomero en {a.name}</span>
          </span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-brass shrink-0" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      ))}
    </div>

    <!-- Houston ZIP Codes Grid -->
    <h2 class="font-display font-black text-2xl text-navy mb-2">Códigos Postales en Houston</h2>
    <p class="text-navy/60 mb-6 text-sm">Cubrimos casi la totalidad de códigos de Houston. Si no ves el tuyo, contáctanos directamente:</p>
    <ul class="grid gap-2.5 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 mb-16">
      {zips.map((z) => (
        <li class="flex items-center gap-2 bg-white border border-navy/10 rounded-xl px-3.5 py-2.5 text-xs font-bold text-navy shadow-xs">
          <span class="h-2 w-2 rounded-full bg-brass"></span>
          <span>{z}</span>
        </li>
      ))}
    </ul>

    <!-- Surrounding communities -->
    <h2 class="font-display font-black text-2xl text-navy mb-6">Comunidades y Ciudades Metropolitanas</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {surrounding.map((c) => (
        <div class="bg-white border border-navy/10 rounded-2xl p-6 shadow-sm">
          <h3 class="flex items-center gap-2 font-display font-bold text-navy text-lg mb-3">
            <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-navy text-brass-light">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            {c.city}
          </h3>
          <div class="flex flex-wrap gap-2">
            {c.zips.map((z) => (
              <span class="inline-block bg-cream border border-navy/10 rounded-lg px-3 py-1 font-display font-semibold text-navy text-xs">{z}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="mt-14 bg-navy text-white rounded-3xl p-8 sm:p-12 text-center shadow-xl border-t-4 border-brass">
      <h2 class="font-display font-black text-2xl sm:text-3xl">¿Tienes dudas sobre tu ubicación?</h2>
      <p class="mt-3 text-white/80 max-w-xl mx-auto leading-relaxed">
        Llámanos al {business.phone} y confirmaremos el tiempo estimado de llegada de una cuadrilla a tu domicilio.
      </p>
      <div class="mt-7 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={business.phoneHref}
          class="hp-lift inline-flex items-center gap-2 rounded-xl bg-brass px-7 py-3.5 font-display text-base font-bold text-white shadow-lg hover:bg-brass-dark transition-colors"
        >
          Llamar al {business.phone}
        </a>
        <ScheduleButton class="px-7 py-3.5" label="Agendar Cita en Línea" />
      </div>
    </div>
  </section>
</BaseLayout>
