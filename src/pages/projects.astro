---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScheduleButton from "../components/ScheduleButton.astro";
import { business } from "../data/business";

const projects = [
  { src: "/images/placeholder.jpeg", alt: `${business.name} trabajo completado con éxito`, feature: true },
  { src: "/images/placeholder.jpeg", alt: `Técnico de ${business.name} atendiendo a cliente satisfecho` },
  { src: "/images/placeholder.jpeg", alt: `Instalación de calentador de agua por ${business.name}` },
  { src: "/images/placeholder.jpeg", alt: `Reparación de tuberías residenciales en Houston` },
  { src: "/images/placeholder.jpeg", alt: `Servicio de drenaje completado por ${business.name}` },
];
---
<BaseLayout
  title={`Galería de Proyectos y Clientes Satisfechos | ${business.name}`}
  description={`Descubre los trabajos recientes realizados por ${business.name} en Houston y los testimonios gráficos de nuestras cuadrillas en acción.`}
  path="/projects"
>
  <!-- Banner -->
  <section class="bg-navy text-white border-b-4 border-brass">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <div class="flex items-center gap-2 font-display text-xs font-bold uppercase tracking-[0.2em] text-brass-light">
        <span class="h-2 w-2 rounded-full bg-brass"></span>
        Nuestro Trabajo en Imágenes
      </div>
      <h1 class="hp-rise mt-3 font-display font-black text-4xl sm:text-5xl">Nuestro Equipo y Trabajos</h1>
      <p class="mt-4 text-white/80 text-lg max-w-2xl leading-relaxed">
        El rostro detrás de {business.name}: técnicos apasionados, instalaciones impecables y clientes que confían plenamente en nuestro servicio.
      </p>
    </div>
  </section>

  <section class="px-6 py-16 max-w-6xl mx-auto">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => (
        <div class={`hp-zoom hp-lift rounded-3xl shadow-sm border border-navy/10 overflow-hidden bg-navy/5 ${p.feature ? "sm:col-span-2 lg:col-span-2" : ""}`}>
          <img
            src={p.src}
            alt={p.alt}
            width="800"
            height="600"
            loading="lazy"
            class={`w-full object-cover transition-transform duration-500 hover:scale-105 ${p.feature ? "h-72 sm:h-96" : "h-64 sm:h-72"}`}
          />
        </div>
      ))}
    </div>

    <div class="mt-16 text-center bg-cream border border-navy/10 rounded-3xl p-10 sm:p-14 shadow-sm">
      <h2 class="font-display font-black text-2xl sm:text-3xl text-navy">¿Tienes un proyecto o reparación en mente?</h2>
      <p class="mt-3 text-navy/70 max-w-xl mx-auto text-base leading-relaxed">
        Hablemos sobre tu necesidad: desde pequeñas reparaciones hasta instalaciones completas o inspección preventiva.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={business.phoneHref}
          class="hp-lift inline-flex items-center justify-center gap-2 rounded-xl bg-navy px-8 py-4 font-display text-base font-bold text-white shadow-md hover:bg-navy-700 transition-colors"
        >
          Llamar al {business.phone}
        </a>
        <ScheduleButton class="px-8 py-4 text-base" label="Agendar Cita en Línea" />
      </div>
    </div>
  </section>
</BaseLayout>
