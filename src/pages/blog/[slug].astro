---
// src/pages/blog/[slug].astro
export const prerender = false;

import OrgLayout from "../../layouts/OrgLayout.astro";
import { orgConfig } from "../../data/orgData";
import { getPostBySlug, formatPostDate, normalizeHtmlContent, type Post } from "../../lib/blog-api";

interface Props {
  post?: Post;
}

let { post } = Astro.props as Props;
const { slug } = Astro.params;

// Si no viene por props, se consulta directamente por slug a la API
if (!post && slug) {
  const fetched = await getPostBySlug(slug);
  if (fetched) {
    post = fetched;
  }
}

// Redirección si el artículo no existe en el CMS
if (!post) {
  return Astro.redirect("/404");
}

const FALLBACK_IMAGE = "/images/placeholder.jpeg";
const featuredImage = post.featured_image_url || FALLBACK_IMAGE;
const formattedDate = formatPostDate(post.published_at);

// Metadatos SEO dinámicos
const metaTitle = (post.seo?.meta_title ?? post.title).trim();
const seoTitle = `${metaTitle} | ${orgConfig.name}`;
const seoDescription = (
  post.seo?.meta_description ??
  post.excerpt ??
  `${post.title} — ${orgConfig.name}.`
).trim();

// JSON-LD Schema para motores de búsqueda
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: seoDescription,
  ...(post.published_at ? { datePublished: post.published_at } : {}),
  ...(post.updated_at ? { dateModified: post.updated_at } : {}),
  image: featuredImage.startsWith("http") ? featuredImage : `https://impulsandolatinos.org${featuredImage}`,
  author: {
    "@type": "Organization",
    name: orgConfig.name,
    url: "https://impulsandolatinos.org",
  },
  publisher: {
    "@type": "Organization",
    name: orgConfig.name,
    logo: {
      "@type": "ImageObject",
      url: "https://impulsandolatinos.org/images/logo.png",
    },
  },
  mainEntityOfPage: `https://impulsandolatinos.org/blog/${post.slug}`,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://impulsandolatinos.org" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://impulsandolatinos.org/blog" },
    { "@type": "ListItem", position: 3, name: post.title, item: `https://impulsandolatinos.org/blog/${post.slug}` },
  ],
};

const jsonLd = [articleSchema, breadcrumbSchema];
---

<OrgLayout
  title={seoTitle}
  description={seoDescription}
  path={`/blog/${post.slug}`}
>
  <!-- Encabezado del Artículo y Breadcrumbs -->
  <section class="bg-gradient-to-b from-blue-950 via-slate-900 to-slate-900 text-white py-12 sm:py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-300">
          <li><a href="/" class="hover:text-amber-400 transition-colors">Inicio</a></li>
          <li aria-hidden="true" class="text-slate-500">/</li>
          <li><a href="/blog" class="hover:text-amber-400 transition-colors">Blog</a></li>
          <li aria-hidden="true" class="text-slate-500">/</li>
          <li class="text-amber-400 truncate max-w-[200px] sm:max-w-md" aria-current="page">
            {post.title}
          </li>
        </ol>
      </nav>

      <h1 class="font-display font-black text-3xl sm:text-4xl md:text-5xl leading-tight text-white">
        {post.title}
      </h1>

      <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-slate-300">
        {formattedDate && (
          <div class="flex items-center gap-1.5 font-medium text-amber-400">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
              <line x1="16" x2="16" y1="2" y2="6" />
              <line x1="8" x2="8" y1="2" y2="6" />
              <line x1="3" x2="21" y1="10" y2="10" />
            </svg>
            <time datetime={post.published_at ?? ""}>{formattedDate}</time>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Contenido del Artículo -->
  <article class="mx-auto max-w-4xl px-6 py-12">
    <!-- Imagen destacada -->
    {post.featured_image_url && (
      <div class="mb-10 rounded-2xl overflow-hidden shadow-lg border border-slate-200 bg-slate-100">
        <img
          src={post.featured_image_url}
          alt={post.title}
          width="1200"
          height="675"
          loading="eager"
          class="w-full max-h-[500px] object-cover"
          onerror={`this.onerror=null;this.src='${FALLBACK_IMAGE}';`}
        />
      </div>
    )}

    {post.excerpt && (
      <p class="text-xl font-medium leading-relaxed text-slate-700 border-l-4 border-amber-500 pl-5 py-1 mb-8 italic bg-amber-50/40 rounded-r-xl">
        {post.excerpt}
      </p>
    )}

    <!-- HTML interpretado y decodificado de forma segura -->
    {post.content ? (
      <div class="prose max-w-none text-slate-800" set:html={normalizeHtmlContent(post.content)} />
    ) : (
      <p class="text-slate-500 italic">No hay contenido adicional disponible para este artículo.</p>
    )}

    <div class="mt-12 pt-6 border-t border-slate-200 flex items-center justify-between">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 font-display font-bold text-blue-700 hover:text-blue-900 transition-colors text-base"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        Volver a todos los artículos
      </a>

      <a
        href="/#contacto"
        class="inline-flex items-center gap-2 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-bold text-sm px-5 py-2.5 rounded-xl shadow transition-all"
      >
        Solicitar Asesoría
      </a>
    </div>
  </article>
</OrgLayout>
