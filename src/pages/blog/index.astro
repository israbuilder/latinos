---
// src/pages/blog/index.astro
export const prerender = false;

import OrgLayout from "../../layouts/OrgLayout.astro";
import { orgConfig } from "../../data/orgData";
import { getPosts, formatPostDate } from "../../lib/blog-api";

const FALLBACK_IMAGE = "/images/placeholder.jpeg";

// Consulta dinámica a la API
const postsResponse = await getPosts({ per_page: 12, page: 1 });
const posts = postsResponse.data || [];
---

<OrgLayout
  title={`Blog & Recursos Informativos | ${orgConfig.name}`}
  description={`Guías, noticias y orientación sobre Pago de Taxes, Trámites de Migración y Coaching Familiar con ${orgConfig.name}.`}
  path="/blog"
>
  <!-- Cabecera Principal -->
  <section class="bg-gradient-to-b from-blue-950 via-slate-900 to-slate-900 text-white py-16 px-6">
    <div class="max-w-6xl mx-auto text-center">
      <h1 class="font-display font-black text-3xl sm:text-5xl text-white">
        Blog &amp; Recursos Informativos
      </h1>
      <p class="mt-4 max-w-2xl mx-auto text-slate-300 text-base sm:text-lg">
        Artículos, novedades y consejos prácticos sobre pago de impuestos (ITIN/SSN), procesos migratorios y bienestar familiar para nuestra comunidad.
      </p>
    </div>
  </section>

  <!-- Grid Dinámico de Artículos -->
  <section class="max-w-6xl mx-auto px-6 py-16">
    {posts.length > 0 ? (
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => {
          const formattedDate = formatPostDate(post.published_at);
          const imageUrl = post.featured_image_url || FALLBACK_IMAGE;

          return (
            <article class="group bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl hover:border-amber-400 flex flex-col transition-all duration-300">
              <a href={`/blog/${post.slug}`} class="block relative aspect-[16/10] bg-slate-100 overflow-hidden">
                <img
                  src={imageUrl}
                  alt={post.title}
                  width="600"
                  height="375"
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  onerror={`this.onerror=null;this.src='${FALLBACK_IMAGE}';`}
                />
              </a>

              <div class="p-6 flex flex-col flex-1">
                {formattedDate && (
                  <div class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-amber-600 mb-3">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
                      <line x1="16" x2="16" y1="2" y2="6" />
                      <line x1="8" x2="8" y1="2" y2="6" />
                      <line x1="3" x2="21" y1="10" y2="10" />
                    </svg>
                    <time datetime={post.published_at ?? ""}>{formattedDate}</time>
                  </div>
                )}

                <h2 class="font-display font-bold text-xl text-slate-900 group-hover:text-blue-700 transition-colors leading-snug">
                  <a href={`/blog/${post.slug}`}>
                    {post.title}
                  </a>
                </h2>

                {post.excerpt && (
                  <p class="mt-3 text-sm text-slate-600 leading-relaxed line-clamp-3 flex-1">
                    {post.excerpt}
                  </p>
                )}

                <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
                  <a
                    href={`/blog/${post.slug}`}
                    class="inline-flex items-center gap-1.5 font-display text-sm font-bold text-blue-700 hover:text-blue-900 transition-colors"
                  >
                    Leer artículo
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12h14" />
                      <path d="m12 5 7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="max-w-2xl mx-auto text-center py-16 px-6 bg-white border border-slate-200 rounded-3xl shadow-sm">
        <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
        </div>
        <h2 class="font-display font-black text-2xl text-slate-900">No hay artículos disponibles todavía</h2>
        <p class="mt-3 text-slate-600 leading-relaxed text-sm sm:text-base">
          Estamos preparando nuevos artículos y guías sobre impuestos, migración y coaching familiar. Vuelve a consultar pronto.
        </p>
        <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/#contacto"
            class="inline-flex items-center justify-center bg-blue-700 hover:bg-blue-800 text-white font-bold text-sm px-6 py-3 rounded-xl shadow transition-all"
          >
            Solicitar Apoyo Directo
          </a>
          <a
            href="/"
            class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-sm px-6 py-3 rounded-xl transition-all"
          >
            Volver al Inicio
          </a>
        </div>
      </div>
    )}
  </section>
</OrgLayout>
