---
// src/pages/blog/index.astro
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { business } from "../../data/business";
import { getPosts, formatPostDate } from "../../lib/blog-api";
import ScheduleButton from "../../components/ScheduleButton.astro";

const FALLBACK_IMAGE = "/images/placeholder.jpeg";

// Consulta dinámica a la API
const postsResponse = await getPosts({ per_page: 12, page: 1 });
const posts = postsResponse.data || [];
---

<BaseLayout
  title={`Blog y Consejos de Plomería | ${business.name}`}
  description={`Guías prácticas, consejos de mantenimiento y artículos oficiales de ${business.name} para proteger tu hogar en Houston.`}
  path="/blog"
>
  <!-- Cabecera Principal -->
  <section class="bg-navy text-white border-b-4 border-brass">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <div class="flex items-center gap-2 font-display text-xs font-bold uppercase tracking-[0.2em] text-brass-light">
        <span class="h-2 w-2 rounded-full bg-brass"></span>
        Blog &amp; Consejos
      </div>
      <h1 class="hp-rise mt-3 font-display font-black text-4xl sm:text-5xl">
        {business.name} Blog
      </h1>
      <p class="mt-4 max-w-2xl text-white/80 text-lg">
        Artículos, guías y consejos prácticos para mantenerte informado y proteger las instalaciones de tu hogar o negocio en Houston.
      </p>
    </div>
  </section>

  <!-- Grid Dinámico de Artículos -->
  <section class="max-w-6xl mx-auto px-6 py-16">
    {posts.length > 0 ? (
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => {
          const formattedDate = formatPostDate(post.published_at);
          const imageUrl = post.featured_image_url || FALLBACK_IMAGE;

          return (
            <article class="hp-lift group bg-white rounded-2xl overflow-hidden border border-navy/10 shadow-sm hover:shadow-xl hover:border-brass/40 flex flex-col transition-all duration-300">
              <a href={`/blog/${post.slug}`} class="hp-zoom block relative aspect-[16/10] bg-navy-800/5 overflow-hidden">
                <img
                  src={imageUrl}
                  alt={post.title}
                  width="600"
                  height="375"
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  onerror={`this.onerror=null;this.src='${FALLBACK_IMAGE}';`}
                />
              </a>

              <div class="p-6 flex flex-col flex-1">
                {formattedDate && (
                  <div class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-brass mb-3">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
                      <line x1="16" x2="16" y1="2" y2="6" />
                      <line x1="8" x2="8" y1="2" y2="6" />
                      <line x1="3" x2="21" y1="10" y2="10" />
                    </svg>
                    <time datetime={post.published_at ?? ""}>{formattedDate}</time>
                  </div>
                )}

                <h2 class="font-display font-bold text-xl text-navy group-hover:text-water transition-colors leading-snug">
                  <a href={`/blog/${post.slug}`}>
                    {post.title}
                  </a>
                </h2>

                {post.excerpt && (
                  <p class="mt-3 text-sm text-navy/70 leading-relaxed line-clamp-3 flex-1">
                    {post.excerpt}
                  </p>
                )}

                <div class="mt-6 pt-4 border-t border-navy/5 flex items-center justify-between">
                  <a
                    href={`/blog/${post.slug}`}
                    class="inline-flex items-center gap-1.5 font-display text-sm font-bold text-water hover:text-navy transition-colors"
                  >
                    Leer artículo
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12h14" />
                      <path d="m12 5 7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="max-w-2xl mx-auto text-center py-16 px-6 bg-white border border-navy/10 rounded-3xl shadow-sm">
        <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-water/10 text-water mb-5">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/>
            <path d="M6 6h10"/>
            <path d="M6 10h10"/>
          </svg>
        </div>
        <h2 class="font-display font-black text-2xl text-navy">No hay artículos disponibles todavía</h2>
        <p class="mt-3 text-navy/70 leading-relaxed">
          Estamos preparando nuevo contenido para esta sección. Vuelve a consultar pronto o comunícate con nosotros para cualquier consulta directa.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={business.phoneHref}
            class="hp-lift inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl bg-navy px-6 py-3.5 font-display text-base font-bold text-white shadow-md hover:bg-navy-700 transition-colors"
          >
            Llamar al {business.phone}
          </a>
          <ScheduleButton class="w-full sm:w-auto px-6 py-3.5" label="Solicitar Servicio" />
        </div>
      </div>
    )}

    <!-- Help Banner CTA -->
    <div class="mt-20 rounded-3xl bg-navy p-8 sm:p-12 text-white shadow-xl relative overflow-hidden border-t-4 border-brass">
      <div class="relative z-10 max-w-2xl">
        <span class="font-display text-xs font-bold uppercase tracking-[0.2em] text-brass-light">Respuesta Rápida 24/7</span>
        <h2 class="mt-2 font-display font-black text-2xl sm:text-3xl">¿Tienes una emergencia de plomería o fuga?</h2>
        <p class="mt-3 text-white/80">
          Nuestros técnicos certificados están listos para atenderte en todo Houston y áreas metropolitanas.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-4">
          <a
            href={business.phoneHref}
            class="hp-lift inline-flex items-center gap-2 rounded-xl bg-brass px-7 py-3.5 font-display text-base font-bold text-white shadow-lg hover:bg-brass-dark transition-colors"
          >
            Llamar {business.phone}
          </a>
          <ScheduleButton class="px-7 py-3.5" label="Agendar en Línea" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
