---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ScheduleButton from "../../components/ScheduleButton.astro";
import { business } from "../../data/business";

const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order
);
---
<BaseLayout
  title={`Servicios de Plomería en Houston, TX | ${business.name}`}
  description={`En ${business.name} ofrecemos reparación de fugas, calentadores de agua, limpieza de drenajes, detección de fugas en losa y plomería de emergencia 24/7 en Houston, TX.`}
  path="/services"
>
  <!-- Banner -->
  <section class="bg-navy text-white border-b-4 border-brass">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <div class="flex items-center gap-2 font-display text-xs font-bold uppercase tracking-[0.2em] text-brass-light">
        <span class="h-2 w-2 rounded-full bg-brass"></span>
        Nuestros Servicios
      </div>
      <h1 class="hp-rise mt-3 font-display font-black text-4xl sm:text-5xl">
        Servicios Profesionales de Plomería en Houston
      </h1>
      <p class="mt-4 text-white/80 text-lg max-w-2xl">
        Desde reparaciones urgentes hasta proyectos de remodelación y nueva construcción. Técnicos licenciados, precios claros y atención inmediata 24/7.
      </p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((svc) => (
        <a href={`/services/${svc.id}`} class="hp-lift group bg-white rounded-2xl border border-navy/10 shadow-sm hover:shadow-xl hover:border-brass/40 p-7 flex flex-col transition-all">
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-navy text-brass-light shadow-sm">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4l-6 6a2 2 0 1 0 2.8 2.8l6-6a4 4 0 0 0 5.4-5.4l-2.3 2.3-2.1-.6-.6-2.1z"/>
            </svg>
          </span>
          <h2 class="mt-5 font-display font-bold text-xl text-navy group-hover:text-water transition-colors">{svc.data.h1}</h2>
          <p class="mt-2.5 text-sm text-navy/70 leading-relaxed flex-1">{svc.data.summary}</p>
          <div class="mt-6 pt-4 border-t border-navy/10 flex items-center justify-between text-water font-display font-bold text-sm">
            <span>Ver detalles del servicio</span>
            <span>→</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Help Box -->
    <div class="mt-16 bg-cream border border-navy/10 rounded-3xl p-8 sm:p-12 text-center shadow-sm">
      <h2 class="font-display font-black text-2xl sm:text-3xl text-navy">¿No encuentras el servicio exacto que buscas?</h2>
      <p class="mt-3 text-navy/70 max-w-xl mx-auto leading-relaxed">
        Si involucra tuberías, agua, drenaje o calentadores, lo resolvemos con garantía total. Llámanos directamente al {business.phone}.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={business.phoneHref}
          class="hp-lift inline-flex items-center justify-center gap-2 rounded-xl bg-navy px-7 py-3.5 font-display text-base font-bold text-white shadow-md hover:bg-navy-700 transition-colors"
        >
          Llamar al {business.phone}
        </a>
        <ScheduleButton class="px-7 py-3.5" label="Agendar Cita en Línea" />
      </div>
    </div>
  </section>
</BaseLayout>
