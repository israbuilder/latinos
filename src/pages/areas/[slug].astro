---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ScheduleButton from "../../components/ScheduleButton.astro";
import RealWorkWidget from "../../components/RealWorkWidget.astro";
import { business } from "../../data/business";
import { areas } from "../../data/areas";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const services = await getCollection("services");
  const svcMap = Object.fromEntries(services.map((s) => [s.id, s.data]));
  return areas.map((area) => ({ params: { slug: area.slug }, props: { area, svcMap } }));
}

const { area, svcMap } = Astro.props;
const url = `${business.url}/areas/${area.slug}`;

const topServices = area.topServices
  .map((slug) => ({ slug, data: svcMap[slug] }))
  .filter((s) => s.data);

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "Plumber",
  "@id": `${business.url}/#business`,
  name: business.name,
  telephone: business.phone,
  url,
  image: business.url + business.logo,
  priceRange: business.priceRange,
  address: {
    "@type": "PostalAddress",
    streetAddress: business.addressParts.street,
    addressLocality: business.addressParts.city,
    addressRegion: business.addressParts.state,
    postalCode: business.addressParts.zip,
    addressCountry: "US",
  },
  areaServed: { "@type": "City", name: `${area.name}, TX` },
  openingHours: business.hours,
  sameAs: [business.socials.facebook, business.socials.instagram, business.socials.google],
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: business.url },
    { "@type": "ListItem", position: 2, name: "Áreas que Atendemos", item: `${business.url}/areas-we-serve` },
    { "@type": "ListItem", position: 3, name: area.name, item: url },
  ],
};
---
<BaseLayout
  title={area.seoTitle}
  description={area.metaDescription}
  path={`/areas/${area.slug}`}
  jsonLd={[localBusinessSchema, breadcrumbSchema]}
>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-navy text-white border-b-4 border-brass">
    <div class="max-w-5xl mx-auto px-6 py-16">
      <a href="/areas-we-serve" class="font-display font-bold text-brass-light text-sm hover:text-white transition-colors flex items-center gap-1.5 mb-3">
        <span>←</span>
        <span>Todas las áreas de cobertura</span>
      </a>
      <p class="font-display font-bold text-brass-light uppercase tracking-[0.2em] text-xs">{area.heroEyebrow}</p>
      <h1 class="hp-rise mt-2 font-display font-black text-4xl sm:text-5xl">{area.h1}</h1>
      <p class="mt-4 text-white/85 text-lg max-w-2xl leading-relaxed">
        Plomeros licenciados y respaldados por la comunidad, atendiendo {area.name} las 24 horas — {business.rating.value}★ de calificación en reseñas de Google.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <ScheduleButton class="px-7 py-3.5 text-base" label="Agendar Cita en Línea" />
        <a href={business.phoneHref} class="hp-lift inline-flex items-center justify-center gap-2 border-2 border-brass text-brass-light hover:bg-brass hover:text-navy px-7 py-3.5 rounded-xl font-display font-bold text-base transition-colors">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Llamar {business.phone}
        </a>
      </div>
    </div>
  </section>

  <section class="px-6 py-14 max-w-5xl mx-auto">
    <div class="prose max-w-none text-navy/90">
      {area.intro.map((p) => <p>{p}</p>)}
    </div>

    <!-- Local plumbing challenges -->
    <div class="mt-10 bg-cream border-l-4 border-brass rounded-2xl p-7 sm:p-8 shadow-sm">
      <h2 class="font-display font-black text-2xl text-navy">Desafíos Comunes de Plomería en {area.name}</h2>
      <p class="mt-3 text-navy/80 text-lg leading-relaxed">{area.localChallenges}</p>
    </div>

    <!-- Top services for this area -->
    <h2 class="mt-14 font-display font-black text-2xl sm:text-3xl text-navy mb-5">Servicios Más Solicitados en {area.name}</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {topServices.map((s) => (
        <a href={`/services/${s.slug}`} class="hp-lift group block bg-white border border-navy/10 rounded-2xl p-6 shadow-sm hover:border-brass/40 hover:shadow-md transition-all">
          <span class="font-display font-bold text-navy group-hover:text-water transition-colors text-lg">{s.data.h1}</span>
          <span class="block text-sm text-navy/65 mt-2 leading-relaxed">{s.data.summary}</span>
          <span class="inline-flex items-center gap-1 font-display font-bold text-water text-xs mt-3">Conocer más →</span>
        </a>
      ))}
    </div>

    <!-- ZIP coverage -->
    <h2 class="mt-14 font-display font-black text-2xl text-navy mb-4">Códigos Postales que Cubrimos en {area.name}</h2>
    <ul class="flex flex-wrap gap-2.5">
      {area.zips.map((z) => (
        <li class="inline-flex items-center gap-2 bg-white border border-navy/10 rounded-xl px-4 py-2.5 shadow-xs text-sm font-bold text-navy">
          <span class="h-2 w-2 rounded-full bg-brass"></span>
          <span>{z}</span>
        </li>
      ))}
    </ul>

    <!-- CTA -->
    <div class="mt-14 bg-navy text-white rounded-3xl p-8 sm:p-12 text-center shadow-xl border-t-4 border-brass">
      <h2 class="font-display font-black text-2xl sm:text-3xl">¿Necesitas un Plomero de Confianza en {area.name}?</h2>
      <p class="mt-3 text-white/80 max-w-xl mx-auto leading-relaxed">
        Agenda online o llámanos directamente al {business.phone}. Respondemos 24/7 para emergencias.
      </p>
      <div class="mt-7 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={business.phoneHref}
          class="hp-lift inline-flex items-center gap-2 rounded-xl bg-brass px-7 py-3.5 font-display text-base font-bold text-white shadow-lg hover:bg-brass-dark transition-colors"
        >
          Llamar al {business.phone}
        </a>
        <ScheduleButton class="px-7 py-3.5" label="Agendar Cita en Línea" />
      </div>
    </div>
  </section>
</BaseLayout>
