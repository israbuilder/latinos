---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { business } from "../data/business";
import { reviews } from "../data/reviews";
import "../styles/global.css";

const {
  title,
  description,
  path,
  image = "/images/placeholder.jpeg",
  ogType = "website",
  jsonLd = [],
  includeReviews = false,
} = Astro.props;

const extraSchemas = (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).filter(Boolean);
const canonical = (business.url + (path || "")).replace(/\/+$/, "") || business.url;

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${business.url}/#business`,
  name: business.name,
  telephone: business.phone,
  url: business.url,
  image: business.url + business.logo,
  logo: business.url + business.logo,
  priceRange: business.priceRange,
  address: {
    "@type": "PostalAddress",
    streetAddress: business.addressParts.street,
    addressLocality: business.addressParts.city,
    addressRegion: business.addressParts.state,
    postalCode: business.addressParts.zip,
    addressCountry: "US",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: business.geo.lat,
    longitude: business.geo.lng,
  },
  areaServed: business.areaServedList,
  openingHours: business.hours,
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    opens: "00:00",
    closes: "23:59",
  },
  hasCredential: {
    "@type": "EducationalOccupationalCredential",
    credentialCategory: "license",
    name: "Texas Licensed Contractor",
    identifier: business.license,
  },
  sameAs: [business.socials.facebook, business.socials.instagram, business.socials.google],
  ...(includeReviews
    ? {
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue: business.rating.value,
          reviewCount: business.rating.count,
          bestRating: "5",
          worstRating: "1",
        },
        review: reviews.map((r) => ({
          "@type": "Review",
          author: { "@type": "Person", name: r.name },
          datePublished: r.date,
          reviewRating: {
            "@type": "Rating",
            ratingValue: r.rating,
            bestRating: 5,
            worstRating: 1,
          },
          reviewBody: r.body,
        })),
      }
    : {}),
};
---
<html lang="es">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HBQPDWHRYY"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-HBQPDWHRYY');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/fav.png" />
    <link rel="apple-touch-icon" href="/images/fav.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
      />
    </noscript>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image.startsWith("http") ? image : business.url + image} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={business.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.startsWith("http") ? image : business.url + image} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {extraSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    <script is:inline>
      (function () {
        try {
          var p = new URLSearchParams(location.search);
          var click =
            p.get("oppref") ||
            p.get("gclid") ||
            p.get("msclkid") ||
            p.get("fbclid");
          var hasUtm =
            p.get("utm_source") || p.get("utm_medium") || p.get("utm_campaign");
          var data = null;
          if (hasUtm || click) {
            data = {
              src:
                p.get("utm_source") ||
                (p.get("oppref")
                  ? "openai"
                  : p.get("gclid")
                    ? "google"
                    : p.get("msclkid")
                      ? "bing"
                      : "facebook"),
              med: p.get("utm_medium") || "cpc",
              camp: p.get("utm_campaign") || "",
              cont: p.get("utm_content") || "",
              lp: location.pathname,
              d: new Date().toISOString().slice(0, 10),
            };
          } else if (
            document.referrer &&
            document.cookie.indexOf("hp_attrib=") === -1
          ) {
            var ref = new URL(document.referrer);
            if (ref.hostname && ref.hostname !== location.hostname) {
              data = {
                src: ref.hostname.replace(/^www\./, ""),
                med: "referral",
                camp: "",
                cont: "",
                lp: location.pathname,
                d: new Date().toISOString().slice(0, 10),
              };
            }
          }
          if (data) {
            document.cookie =
              "hp_attrib=" +
              encodeURIComponent(JSON.stringify(data)) +
              "; path=/; max-age=7776000; SameSite=Lax";
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:left-4 focus:top-4 focus:rounded-lg focus:bg-navy focus:px-4 focus:py-2 focus:text-white focus:shadow-lg"
    >
      Saltar al contenido principal
    </a>
    <Header />
    <main id="main" class="flex-1"><slot /></main>
    <Footer />
  </body>
</html>
