---
import type { Locale } from "../data/orgData";
import { uiTranslations } from "../data/translations";
import { orgConfig } from "../data/orgData";

interface Props {
  currentLocale: Locale;
}

const { currentLocale } = Astro.props;
const t = uiTranslations[currentLocale];
const isEs = currentLocale === "es";
const basePath = isEs ? "" : "/en";
const year = new Date().getFullYear();
---

<footer class="bg-slate-950 text-slate-300 border-t-4 border-amber-500 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-6 grid gap-10 md:grid-cols-2 lg:grid-cols-4">
    <!-- Brand Info -->
    <div>
      <div class="flex items-center gap-3">
        <img
          src="/images/logo.png"
          alt="Impulsando Latinos"
          width="180"
          height="50"
          class="h-11 w-auto object-contain brightness-0 invert"
        />
      </div>
      <p class="mt-4 text-sm text-slate-400 leading-relaxed">
        {t.footer.about}
      </p>
    </div>

    <!-- Quick Services -->
    <div>
      <h3 class="font-display font-bold text-amber-400 uppercase text-xs tracking-widest mb-4">
        {isEs ? "Pilares de Apoyo" : "Support Pillars"}
      </h3>
      <ul class="space-y-3 text-sm">
        <li>
          <a href={`${basePath}/#taxes`} class="hover:text-amber-400 transition-colors flex items-center gap-2 text-white font-semibold">
            <span class="text-amber-400 text-xs">★</span>
            {isEs ? "Pago de Taxes & Asesoría Fiscal (Principal)" : "Tax Filing & Payments (Primary)"}
          </a>
        </li>
        <li>
          <a href={`${basePath}/#migracion`} class="text-slate-400 hover:text-white transition-colors flex items-center gap-2">
            <span class="text-blue-400 text-xs">›</span>
            {isEs ? "Casos y Trámites de Migración" : "Immigration Cases & Guidance"}
          </a>
        </li>
        <li>
          <a href={`${basePath}/#coach-familiar`} class="text-slate-400 hover:text-white transition-colors flex items-center gap-2">
            <span class="text-blue-400 text-xs">›</span>
            {isEs ? "Coach Familiar & Bienestar Emocional" : "Family Coaching & Wellbeing"}
          </a>
        </li>
        <li>
          <a href={`${basePath}/#calculadora`} class="text-slate-400 hover:text-white transition-colors flex items-center gap-2">
            <span class="text-blue-400 text-xs">›</span>
            {isEs ? "Calculadora de Estimación de Taxes" : "Tax Refund Estimator"}
          </a>
        </li>
        <li>
          <a href="/blog" class="text-slate-400 hover:text-white transition-colors flex items-center gap-2">
            <span class="text-blue-400 text-xs">›</span>
            {isEs ? "Blog & Recursos Informativos" : "Blog & Resource Guides"}
          </a>
        </li>
      </ul>
    </div>

    <!-- Contact & Attention -->
    <div>
      <h3 class="font-display font-bold text-amber-400 uppercase text-xs tracking-widest mb-4">
        {isEs ? "Contacto Directo" : "Direct Contact"}
      </h3>
      <ul class="space-y-3 text-sm text-slate-400">
        <li class="flex items-start gap-2.5">
          <svg class="w-5 h-5 text-amber-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <div>
            <span class="block text-xs text-slate-500 font-semibold">{isEs ? "Línea Telefónica Directa" : "Direct Phone Line"}</span>
            <a href={orgConfig.contact.phoneHref} class="text-white hover:text-amber-400 font-bold">
              {orgConfig.contact.phone}
            </a>
          </div>
        </li>
        <li class="flex items-start gap-2.5">
          <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          <div>
            <span class="block text-xs text-slate-500 font-semibold">WhatsApp Comunitario</span>
            <a href={orgConfig.contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="text-white hover:text-emerald-400 font-semibold">
              {orgConfig.contact.whatsapp}
            </a>
          </div>
        </li>
        <li class="flex items-start gap-2.5">
          <svg class="w-5 h-5 text-blue-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span class="text-xs">{orgConfig.contact.address}</span>
        </li>
      </ul>
    </div>

    <!-- Hours & Languages -->
    <div>
      <h3 class="font-display font-bold text-amber-400 uppercase text-xs tracking-widest mb-4">
        {isEs ? "Horarios & Idiomas" : "Hours & Languages"}
      </h3>
      <p class="text-sm text-slate-300">
        {orgConfig.contact.hours[currentLocale]}
      </p>
      <div class="mt-4 pt-4 border-t border-slate-800">
        <span class="text-xs text-slate-400 block mb-2">{isEs ? "Atención garantizada en:" : "Guaranteed service in:"}</span>
        <div class="flex gap-2">
          <span class="px-3 py-1 rounded bg-slate-800 text-white font-bold text-xs border border-slate-700">Español 100%</span>
          <span class="px-3 py-1 rounded bg-slate-800 text-white font-bold text-xs border border-slate-700">English Fluent</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Disclaimer and Copyright -->
  <div class="max-w-7xl mx-auto px-6 mt-12 pt-8 border-t border-slate-800/80">
    <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-4 mb-6">
      <p class="text-xs text-slate-400 leading-relaxed">
        {t.footer.disclaimer}
      </p>
    </div>
    <div class="flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>© {year} {orgConfig.fullName[currentLocale]}. {t.footer.rights}</p>
      <div class="flex items-center gap-4">
        <a href={isEs ? "/en" : "/"} class="hover:text-amber-400 transition-colors">
          {isEs ? "Switch to English" : "Cambiar a Español"}
        </a>
        <span>·</span>
        <a href={`${basePath}/#contacto`} class="hover:text-amber-400 transition-colors">
          {isEs ? "Privacidad y Confidencialidad" : "Privacy & Confidentiality"}
        </a>
      </div>
    </div>
  </div>
</footer>

