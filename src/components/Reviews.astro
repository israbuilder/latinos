---
import { business } from "../data/business";
import { reviews } from "../data/reviews";

const featured = reviews.slice(0, 4);
---
<section class="bg-white px-6 py-20 border-y-4 border-brass">
  <div class="max-w-6xl mx-auto">
    <div class="text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brass/10 text-brass-dark font-display text-xs font-bold uppercase tracking-[0.2em]">
        <span class="h-2 w-2 rounded-full bg-brass"></span>
        Opiniones Verificadas
      </div>
      <h2 class="mt-3 font-display font-black text-3xl sm:text-4xl text-navy">
        La Comunidad Confía en {business.name}
      </h2>
      <div class="mt-4 flex items-center justify-center gap-2">
        <span class="flex items-center gap-0.5 text-brass" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => (
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27l5.18 3.12-1.37-5.9 4.55-3.95-6-.52L12 4.5 9.64 10.02l-6 .52 4.55 3.95-1.37 5.9z"/></svg>
          ))}
        </span>
        <span class="font-display font-black text-navy text-lg">{business.rating.value} / 5.0</span>
        <span class="text-navy/70 text-sm">({business.rating.count}+ reseñas verificadas en Google)</span>
      </div>
    </div>

    <!-- Review cards -->
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {featured.map((r) => (
        <li class="hp-lift flex flex-col rounded-2xl border border-navy/10 bg-cream p-6 shadow-sm hover:border-brass/40 hover:shadow-md transition-all">
          <span class="flex items-center gap-0.5 text-brass" aria-label={`${r.rating} de 5 estrellas`}>
            {Array.from({ length: r.rating }).map(() => (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27l5.18 3.12-1.37-5.9 4.55-3.95-6-.52L12 4.5 9.64 10.02l-6 .52 4.55 3.95-1.37 5.9z"/></svg>
            ))}
          </span>
          <p class="mt-4 flex-1 text-navy/85 text-[0.95rem] leading-relaxed italic">
            "{r.body}"
          </p>
          <div class="mt-5 pt-4 border-t border-navy/10">
            <p class="font-display font-bold text-navy text-base">{r.name}</p>
            {r.location && <p class="text-navy/60 text-xs mt-0.5">{r.location}</p>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
