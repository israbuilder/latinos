---
// "Schedule Now" CTA with progressive enhancement
import { business } from "../data/business";

interface Props {
  label?: string;
  class?: string;
}
const { label = "Schedule Now", class: className = "" } = Astro.props;
---
<a
  href={business.booking.pageUrl}
  target="_blank"
  rel="noopener noreferrer"
  data-hcp-book
  class={`hp-lift inline-flex items-center justify-center gap-2 bg-brass hover:bg-brass-dark text-white font-display font-bold tracking-tight px-6 py-3 rounded-xl shadow-lg shadow-brass/25 transition-all duration-200 ${className}`}
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
    <line x1="16" x2="16" y1="2" y2="6" />
    <line x1="8" x2="8" y1="2" y2="6" />
    <line x1="3" x2="21" y1="10" y2="10" />
  </svg>
  <span>{label}</span>
</a>

<script>
  document.querySelectorAll("[data-hcp-book]").forEach((el) => {
    el.addEventListener("click", (event) => {
      const widget = (window as any).HCPWidget;
      if (widget && typeof widget.openModal === "function") {
        event.preventDefault();
        widget.openModal();
      }
    });
  });
</script>
