---
import { business } from "../data/business";
import ScheduleButton from "./ScheduleButton.astro";

const links = [
  { href: "/services", label: "SERVICIOS" },
  { href: "/community-mission", label: "MISIÓN" },
  { href: "/coupons", label: "CUPONES" },
  { href: "/blog", label: "BLOG" },
  { href: "/careers", label: "EMPLEO" },
  { href: "/areas-we-serve", label: "ÁREAS DE COBERTURA" },
  { href: "/contact", label: "CONTACTO" },
];
---
<!-- Top Trust / Emergency Bar -->
<div class="bg-navy-800 text-white text-xs border-b border-white/10 py-2 px-4 hidden sm:block">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5 text-brass-light font-bold">
        <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Servicio de Emergencia 24/7 en Houston y Suburbios
      </span>
      <span class="text-white/40">|</span>
      <span class="text-white/80">{business.trustedPhrase}</span>
    </div>
    <div class="flex items-center gap-4 text-white/90">
      <span>{business.license}</span>
      <span class="text-white/40">|</span>
      <a href={`mailto:${business.email}`} class="hover:text-brass-light transition-colors">{business.email}</a>
    </div>
  </div>
</div>

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md text-navy shadow-md border-b border-navy/10">
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-4 px-4 sm:px-6 py-3">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 shrink-0" aria-label={`${business.name} Inicio`}>
      <img
        src="/images/logo-latinos.svg"
        alt={`${business.name} logo`}
        width="220"
        height="52"
        class="h-12 sm:h-14 w-auto object-contain"
      />
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-5 xl:gap-7 text-xs xl:text-sm font-bold tracking-wide" aria-label="Navegación principal">
      {links.map((l) => (
        <a
          href={l.href}
          class="text-navy/85 hover:text-brass transition-colors relative py-1 after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-brass after:scale-x-0 hover:after:scale-x-100 after:transition-transform"
        >
          {l.label}
        </a>
      ))}
    </nav>

    <!-- Call to Actions -->
    <div class="flex items-center gap-3 sm:gap-4">
      <a
        href={business.phoneHref}
        class="hp-lift flex shrink-0 items-center gap-2 font-display font-extrabold text-navy hover:text-brass transition-colors text-sm sm:text-base py-2 px-3 rounded-xl bg-navy/5 border border-navy/10"
      >
        <span class="p-1.5 rounded-lg bg-brass text-white flex items-center justify-center">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </span>
        <span class="hidden sm:inline">{business.phone}</span>
      </a>

      <div class="hidden sm:block">
        <ScheduleButton class="px-5 py-2.5 text-sm" label="Agendar Cita" />
      </div>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="lg:hidden inline-flex items-center justify-center p-2 rounded-xl border border-navy/20 bg-white hover:bg-navy/5 text-navy transition-colors"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <nav
    id="mobile-menu"
    class="hidden lg:hidden bg-navy-800 text-white border-b-4 border-brass px-5 py-5"
    aria-label="Navegación móvil"
    hidden
  >
    <ul class="flex flex-col gap-1.5 max-w-7xl mx-auto">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class="block py-2.5 px-3 rounded-xl font-bold text-white/90 hover:bg-white/10 hover:text-brass-light transition-colors text-sm"
          >
            {l.label}
          </a>
        </li>
      ))}
      <li class="pt-3 border-t border-white/15 mt-2">
        <a href={business.phoneHref} class="flex items-center gap-2 py-2 px-3 font-display font-extrabold text-brass-light text-base">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Llamar al {business.phone}
        </a>
      </li>
      <li class="pt-2">
        <ScheduleButton class="w-full text-center py-3 text-base" label="Agendar Cita en Línea" />
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
      menu.hidden = !open;
      menu.classList.toggle("hidden", !open);
    };
    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
