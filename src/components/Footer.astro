---
import { business } from "../data/business";
import { getCollection } from "astro:content";

const year = new Date().getFullYear();
const navLinks = [
  { href: "/services", label: "Servicios" },
  { href: "/about", label: "Nuestro Equipo" },
  { href: "/projects", label: "Galería de Trabajos" },
  { href: "/areas-we-serve", label: "Áreas de Cobertura" },
  { href: "/coupons", label: "Cupones y Ofertas" },
  { href: "/community-mission", label: "Misión Comunitaria" },
  { href: "/blog", label: "Blog & Consejos" },
  { href: "/contact", label: "Contacto" },
];

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---
<footer class="bg-navy-800 text-white border-t-4 border-brass">
  <div class="max-w-7xl mx-auto px-6 py-14 grid gap-10 md:grid-cols-2 lg:grid-cols-4">
    <!-- Brand Info -->
    <div>
      <img
        src="/images/logo-latinos.svg"
        alt={`${business.name} logo`}
        width="220"
        height="55"
        loading="lazy"
        class="h-14 w-auto bg-white/95 rounded-xl p-2 object-contain"
      />
      <p class="mt-4 font-display text-base font-bold text-brass-light italic leading-snug">
        "{business.trustedPhrase}"
      </p>
      <p class="mt-2 text-sm text-white/70">
        Residencial · Comercial · Atención de Emergencia 24/7 en Todo Houston
      </p>
      <div class="mt-4 inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/10 text-xs font-semibold text-white/90">
        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
        {business.license}
      </div>
    </div>

    <!-- Services Column -->
    <div>
      <h2 class="font-display font-bold text-brass-light uppercase text-xs tracking-[0.2em]">Servicios Principales</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {services.map((s) => (
          <li>
            <a href={`/services/${s.id}`} class="text-white/80 hover:text-brass-light transition-colors flex items-center gap-1.5">
              <span class="text-brass text-xs">›</span>
              {s.data.h1}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Quick Links Column -->
    <div>
      <h2 class="font-display font-bold text-brass-light uppercase text-xs tracking-[0.2em]">Navegación Rápida</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {navLinks.map((l) => (
          <li>
            <a href={l.href} class="text-white/80 hover:text-brass-light transition-colors flex items-center gap-1.5">
              <span class="text-brass text-xs">›</span>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Contact & Socials Column -->
    <div>
      <h2 class="font-display font-bold text-brass-light uppercase text-xs tracking-[0.2em]">Atención Inmediata</h2>
      <a href={business.phoneHref} class="mt-3 block font-display text-2xl font-black text-white hover:text-brass-light transition-colors">
        {business.phone}
      </a>
      <p class="mt-2 text-xs font-semibold text-brass-light uppercase tracking-wider">{business.hoursDisplay}</p>
      <p class="mt-3 text-sm text-white/80">{business.address}</p>
      <p class="mt-1 text-xs text-white/60">Cobertura en {business.areaServed} y condados cercanos</p>

      <div class="mt-5 flex gap-2.5">
        <a href={business.socials.facebook} aria-label={`${business.name} en Facebook`} class="p-2.5 rounded-xl bg-white/10 hover:bg-water transition-colors" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
        </a>
        <a href={business.socials.instagram} aria-label={`${business.name} en Instagram`} class="p-2.5 rounded-xl bg-white/10 hover:bg-water transition-colors" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><line x1="17.5" y1="6.5" x2="17.5" y2="6.5"/></svg>
        </a>
        <a href={business.socials.google} aria-label={`${business.name} en Google`} class="p-2.5 rounded-xl bg-white/10 hover:bg-water transition-colors" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 12v3.6h5.1c-.2 1.3-1.6 3.9-5.1 3.9-3.1 0-5.6-2.6-5.6-5.7s2.5-5.7 5.6-5.7c1.8 0 2.9.8 3.6 1.4l2.5-2.4C16.9 4.9 14.7 4 12 4 6.9 4 2.8 8.1 2.8 13.2S6.9 22.4 12 22.4c5.9 0 9.7-4.1 9.7-9.9 0-.7-.1-1.2-.2-1.7H12z"/></svg>
        </a>
        <a href={business.socials.tiktok} aria-label={`${business.name} en TikTok`} class="p-2.5 rounded-xl bg-white/10 hover:bg-water transition-colors" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.94 1.61v14.17a2.83 2.83 0 0 1-2.83 2.83 2.83 2.83 0 0 1-2.83-2.83 2.84 2.84 0 0 1 2.83-2.84V9.17A6.61 6.61 0 0 0 3.5 15.78a6.61 6.61 0 0 0 6.61 6.61 6.61 6.61 0 0 0 6.61-6.61V9.17l.2.1a8.08 8.08 0 0 0 3.58.84V6.33a4.84 4.84 0 0 1-3.67-4.7z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/60">
      <p>© {year} {business.name}. Todos los derechos reservados · {business.license}.</p>
      <p>{business.trustedPhrase} · {business.areaServed}</p>
    </div>
  </div>
</footer>
