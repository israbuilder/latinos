---
import type { Locale } from "../data/orgData";
import { uiTranslations } from "../data/translations";

interface Props {
  currentLocale: Locale;
}

const { currentLocale } = Astro.props;
const t = uiTranslations[currentLocale].contactSection;
---

<div class="bg-white rounded-3xl shadow-xl border border-slate-200 p-8 sm:p-10 max-w-3xl mx-auto">
  <div class="text-center mb-8">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-100 text-blue-900 text-xs font-bold uppercase tracking-wider mb-2">
      <span class="w-2 h-2 rounded-full bg-blue-600"></span>
      {t.tag}
    </span>
    <h3 class="text-2xl sm:text-3xl font-black text-slate-900 font-display">
      {t.title}
    </h3>
    <p class="text-slate-600 text-sm sm:text-base mt-2 max-w-xl mx-auto">
      {t.desc}
    </p>
  </div>

  <form id="assistance-form" class="space-y-5">
    <div class="grid sm:grid-cols-2 gap-5">
      <div>
        <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          {t.form.name} *
        </label>
        <input
          type="text"
          id="contact-name"
          name="name"
          required
          placeholder="Ej. Carlos Martínez"
          class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-slate-800 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all"
        />
      </div>

      <div>
        <label for="contact-phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          {t.form.phone} *
        </label>
        <input
          type="tel"
          id="contact-phone"
          name="phone"
          required
          placeholder="(346) 000-0000"
          class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-slate-800 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all"
        />
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-5">
      <div>
        <label for="contact-email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          {t.form.email}
        </label>
        <input
          type="email"
          id="contact-email"
          name="email"
          placeholder="tu-correo@ejemplo.com"
          class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-slate-800 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all"
        />
      </div>

      <div>
        <label for="service-interest" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          {t.form.serviceInterest} *
        </label>
        <select
          id="service-interest"
          name="serviceInterest"
          required
          class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-slate-800 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all font-semibold"
        >
          <option value="taxes" selected>{t.form.optionTaxes}</option>
          <option value="immigration">{t.form.optionImmigration}</option>
          <option value="coaching">{t.form.optionCoaching}</option>
          <option value="all">{t.form.optionAll}</option>
        </select>
      </div>
    </div>

    <div>
      <label for="contact-notes" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
        {t.form.notes}
      </label>
      <textarea
        id="contact-notes"
        name="notes"
        rows="3"
        placeholder="Ej. Necesito tramitar mi ITIN y declarar mis taxes de este año y el anterior..."
        class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-slate-800 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all"
      ></textarea>
    </div>

    <div class="pt-2">
      <button
        type="submit"
        id="btn-submit-lead"
        class="w-full bg-gradient-to-r from-blue-700 to-indigo-800 hover:from-blue-800 hover:to-indigo-900 text-white font-black text-sm uppercase tracking-wider py-4 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 cursor-pointer transform hover:-translate-y-0.5"
      >
        {t.form.submit}
      </button>
    </div>

    <!-- Privacy Note -->
    <div class="flex items-center justify-center gap-2 text-center text-xs text-slate-500 pt-2">
      <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd" />
      </svg>
      <span>{t.form.disclaimer}</span>
    </div>

    <!-- Feedback Message Container -->
    <div id="form-feedback" class="hidden p-4 rounded-xl text-center text-sm font-semibold"></div>
  </form>
</div>

<script>
  const form = document.getElementById("assistance-form") as HTMLFormElement;
  const feedback = document.getElementById("form-feedback");
  const submitBtn = document.getElementById("btn-submit-lead") as HTMLButtonElement;

  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!submitBtn || !feedback) return;

      const originalText = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = "Procesando...";

      setTimeout(() => {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
        form.reset();

        feedback.classList.remove("hidden", "bg-red-50", "text-red-800");
        feedback.classList.add("bg-emerald-50", "text-emerald-800", "border", "border-emerald-200");
        feedback.textContent = "✓ ¡Solicitud recibida con éxito! Uno de nuestros asesores especializados te contactará a la brevedad.";
        
        feedback.scrollIntoView({ behavior: "smooth", block: "center" });
      }, 700);
    });
  }
</script>

